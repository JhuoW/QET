{
 "description": "Compile rules (SPEC §4). Edges are [u, v, sorted labels] with u earlier than v.",
 "cases": [
  {
   "name": "running",
   "note": "Method page §4 worked example: A->C, B->C (data).",
   "input": {
    "request": "Find the price of a flight from NYC to SG and the price of 3 nights at a hotel in SG, then compute the total cost.",
    "steps": [
     {
      "tool": "get_flight_price",
      "args": {
       "from": "NYC",
       "to": "SG"
      },
      "obs": {
       "price": 1200
      }
     },
     {
      "tool": "get_hotel_price",
      "args": {
       "city": "SG",
       "nights": 3
      },
      "obs": {
       "price": 600
      }
     },
     {
      "tool": "calculate_total",
      "args": {
       "flight_price": 1200,
       "hotel_price": 600
      },
      "obs": {
       "total": 1800
      }
     }
    ],
    "contracts": {
     "get_flight_price": {
      "reads": [
       "flights"
      ],
      "writes": [],
      "volatile": [
       "request_id"
      ]
     },
     "get_hotel_price": {
      "reads": [
       "hotels"
      ],
      "writes": [],
      "volatile": [
       "request_id"
      ]
     },
     "calculate_total": {
      "reads": [],
      "writes": []
     }
    }
   },
   "expected_edges": [
    [
     0,
     2,
     [
      "data"
     ]
    ],
    [
     1,
     2,
     [
      "data"
     ]
    ]
   ],
   "expected_canonical_order": [
    0,
    1,
    2
   ],
   "expected_n_states": 5,
   "expected_n_orders": 2
  },
  {
   "name": "seven_step",
