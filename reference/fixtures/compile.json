       "to": "SG"
      },
      "obs": {
       "status": "booked"
      }
     }
    ],
    "contracts": {
     "get_flight_price": {
      "reads": [
       "flights"
      ],
      "writes": []
     },
     "book_flight": {
      "reads": [
       "flights"
      ],
      "writes": [
       "flights"
